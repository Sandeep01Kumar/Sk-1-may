node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# =============================================================================
# Build & bundler outputs
# =============================================================================
dist/
build/
.vite/
.cache/
*.tsbuildinfo

# =============================================================================
# Test outputs (Vitest + Playwright)
# =============================================================================
coverage/
coverage-final.json
test-results/
playwright-report/
playwright/.cache/

# Playwright snapshot diffs (failures are uploaded as CI artefacts; not committed)
**/__snapshots__/**/*-actual.png
**/__snapshots__/**/*-diff.png
**/*-snapshots/**/*-actual.png
**/*-snapshots/**/*-diff.png

# =============================================================================
# Environment variables & secrets
# =============================================================================
.env
.env.*
!.env.example
.envrc

# Percy token (cloud visual regression - optional per AAP Section 0.6.1)
.percy.yaml
.percy.json
percy.token

# =============================================================================
# IDE / Editor state
# =============================================================================
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

