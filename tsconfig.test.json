{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": [
            "vitest/globals",
            "@testing-library/jest-dom",
            "@playwright/test",
            "node",
            "vite/client"
        ],
        "paths": {
            "@/*": ["./src/*"],
            "@tests/*": ["./tests/*"]
        },
        "noEmit": true,
        "isolatedModules": true,
        "allowJs": false,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts"
    ],
    "exclude": ["node_modules", "dist", "coverage", "playwright-report", "test-results"]
}
