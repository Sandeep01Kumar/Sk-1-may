{
  "name": "hello_world",
  "version": "1.0.0",
  "description": "Hello world in Node.js",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:a11y",
    "test:unit": "vitest run --dir tests/unit",
    "test:component": "vitest run --dir tests/component",
    "test:integration": "vitest run --dir tests/integration",
    "test:a11y": "vitest run --dir tests/a11y",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "cross-env PWDEBUG=1 playwright test",
    "test:visual": "playwright test --config=playwright.config.ts --grep @visual",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.test.json"
  },
  "author": "hxu",
  "license": "MIT",
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/cli": "4.11.3",
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.2.8",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.41",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.6",
    "axe-core": "4.11.4",
    "cross-env": "10.1.0",
    "eslint": "10.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.6.0",
    "happy-dom": "20.9.0",
    "jest-axe": "10.0.0",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  }
}
